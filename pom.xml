<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.springshop</groupId>
    <artifactId>spring-shop</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>spring-shop</name>
    <description>电商项目基础框架（单体应用）</description>

    <modules>
        <module>spring-shop-common</module>
        <module>spring-shop-user</module>
        <module>spring-shop-admin</module>
        <module>spring-shop-product</module>
        <module>spring-shop-cart</module>
        <module>spring-shop-order</module>
        <module>spring-shop-pay</module>
        <module>spring-shop-stats</module>
        <module>spring-shop-web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <springdoc.version>2.8.9</springdoc.version>
        <swagger-annotations.version>2.2.28</swagger-annotations.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Excel 读写（批量导入 / 导出）；Spring Boot BOM 未托管 Fesod，需显式指定版本。
             Fesod 是 POI 的流式封装（原 EasyExcel / FastExcel 的 Apache 孵化版），
             读走 SAX、写走分批缓存，是「上万行导入导出」场景的选型依据。
             注意：fesod-sheet 会传递引入 POI 5.5.x，不要再单独声明 poi-ooxml，
             否则两个 POI 版本共存会出现 NoSuchMethodError。 -->
        <fesod.version>2.0.2-incubating</fesod.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.springshop</groupId>
                <artifactId>spring-shop-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.springshop</groupId>
                <artifactId>spring-shop-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.springshop</groupId>
                <artifactId>spring-shop-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.springshop</groupId>
                <artifactId>spring-shop-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.springshop</groupId>
                <artifactId>spring-shop-cart</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.springshop</groupId>
                <artifactId>spring-shop-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.springshop</groupId>
                <artifactId>spring-shop-pay</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.springshop</groupId>
                <artifactId>spring-shop-stats</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- JWT 三件套：api 编译期、impl/jackson 运行期 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- 文档注解：供各业务模块的 Controller 标注 @Tag/@Operation（轻量，不引入整个文档 starter） -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>
            <!-- Excel 读写：fesod-sheet 同时覆盖 xlsx（SAX 流式读 / 分批写）与 xls、csv -->
            <dependency>
                <groupId>org.apache.fesod</groupId>
                <artifactId>fesod-sheet</artifactId>
                <version>${fesod.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
