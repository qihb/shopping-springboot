#!/bin/sh

# commit-msg hook：git 提交信息规范校验
# 规范格式：<类型>: <简述>  例：feat: 新增用户注册接口
# 合法类型：feat / fix / refactor / docs / chore
# 启用方式：git config core.hooksPath .githooks

commit_msg_file="$1"

# merge / revert / amend 等自动生成的信息直接放行
first_line=$(head -n 1 "$commit_msg_file")
case "$first_line" in
  Merge*|Revert*|amend*) exit 0 ;;
esac

# 取首行作为 subject，并去除首尾空白
subject=$(sed -n '1p' "$commit_msg_file")
subject=$(echo "$subject" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

if [ -z "$subject" ]; then
  echo "错误：提交信息不能为空"
  echo "要求：<类型>: <简述>，例：feat: 新增用户注册接口"
  exit 1
fi

if ! echo "$subject" | grep -Eq '^(feat|fix|refactor|docs|chore): .+'; then
  echo "错误：提交信息不符合规范，要求 <类型>: <简述>"
  echo "类型必须为以下之一：feat / fix / refactor / docs / chore"
  echo "示例：feat: 新增用户注册接口"
  exit 1
fi

# 简述长度限制
desc_len=$(echo "$subject" | awk -F': ' '{ print length($2) }')
if [ "$desc_len" -gt 100 ]; then
  echo "错误：提交简述过长（当前 ${desc_len} 字符，最长 100 字符）"
  exit 1
fi

exit 0
